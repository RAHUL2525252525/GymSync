{
  "info": {
    "name": "Gym Membership Tracker API",
    "description": "Postman collection for testing the Gym Membership Tracker FastAPI backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9999999999\"\n}"
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"srinivasrahul838@gmail.com\",\n  \"password\": \"Rahul@838\"\n}"
            }
          }
        },
        {
          "name": "Login Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Members (Admin)",
      "item": [
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/members/"
          }
        },
        {
          "name": "Delete Member",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/members/1"
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "List Plans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/plans/"
          }
        },
        {
          "name": "Create Plan (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/plans/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gold Plan\",\n  \"duration_months\": 3,\n  \"price\": 2999,\n  \"description\": \"Full gym access + trainer sessions\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Trainers",
      "item": [
        {
          "name": "List Trainers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/trainers/"
          }
        },
        {
          "name": "Add Trainer (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/trainers/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mike Trainer\",\n  \"specialization\": \"Strength Training\",\n  \"phone\": \"8888888888\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Memberships (Admin)",
      "item": [
        {
          "name": "Assign Membership",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/memberships/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"plan_id\": 1,\n  \"trainer_id\": 1,\n  \"start_date\": \"2026-09-13\",\n  \"end_date\": \"2026-12-13\"\n}"
            }
          }
        },
        {
          "name": "My Memberships (Member)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/memberships/me"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Check In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/attendance/checkin"
          }
        },
        {
          "name": "Check Out",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/attendance/checkout/1"
          }
        },
        {
          "name": "My Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/attendance/me"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Record Payment (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/payments/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"membership_id\": 1,\n  \"amount\": 2999\n}"
            }
          }
        },
        {
          "name": "My Payments (Member)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/payments/me"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/dashboard/admin"
          }
        },
        {
          "name": "User Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/dashboard/user"
          }
        }
      ]
    }
  ]
}
